# =========================
# Root-level .gitignore
# =========================

# ----- OS files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- IDE / Editor -----
.idea/
.vscode/
*.swp
*.swo
*~

# ----- Agent / GSD state -----
.agent/
.agents/
.gsd/
.gemini/

# ----- Node.js (backend) -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Backend env & database -----
backend/.env
backend/database.sqlite
backend/database.sqlite-shm
backend/database.sqlite-wal
backend/backups/

# ----- Flutter / Dart -----
kumbh_app/.dart_tool/
kumbh_app/build/
kumbh_app/.flutter-plugins
kumbh_app/.flutter-plugins-dependencies
kumbh_app/.packages
kumbh_app/*.iml
kumbh_app/.metadata
kumbh_app/flutter_01.log

# ----- Logs -----
*.log
