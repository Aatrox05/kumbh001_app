# NASHIK KUMBH MELA — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Rename this file to .env before starting backend in staging/production.

# ----------------------------------------------------
# SERVER & ENVIRONMENT
# ----------------------------------------------------
PORT=3000
NODE_ENV=development # Set to 'production' or 'staging' in deployment
JWT_SECRET=ReplaceWithAStrongSecret32CharsMin!

# ----------------------------------------------------
# DATABASE CONFIGURATION
# Development defaults to SQLite. Production MUST use PostgreSQL.
# ----------------------------------------------------
# DB_FILE=database.sqlite

# PostgreSQL Production Cluster Configuration (Required if NODE_ENV=production)
# POSTGRES_HOST=postgres-cluster.kumbh.gov.in
# POSTGRES_PORT=5432
# POSTGRES_USER=kumbh_admin
# POSTGRES_PASSWORD=SetSecurePostgresPasswordHere!
# POSTGRES_DB=kumbh_db
# DATABASE_URL=postgres://kumbh_admin:SetSecurePostgresPasswordHere!@postgres-cluster.kumbh.gov.in:5432/kumbh_db

# ----------------------------------------------------
# FIREBASE CLOUD MESSAGING (FCM) CONFIGURATION
# Required for sending live push notifications to physical mobile devices
# ----------------------------------------------------
# FIREBASE_PROJECT_ID=nashik-kumbh-mela-prod
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./config/firebase-service-account.json

# ----------------------------------------------------
# GOOGLE MAPS PLATFORM API KEYS
# Required for rendering official map tiles and directions
# ----------------------------------------------------
# GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# ----------------------------------------------------
# AI PROVIDER CONFIGURATION
# ----------------------------------------------------
# AI_API_KEY=sk-YourOpenAIKeyHere
